knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(forcats)
data <- read.csv("../stimuli/sachs/SourceData_1.csv")
negative_potential_stims <- data %>%
subset(song == 'stimuli/3_pieceB_joyous_anxious_sad' | song == 'stimuli/5_pieceB_calm_sad_anxious' | song == 'stimuli/6_pieceB_anxious_calm_joyous' | song == 'stimuli/7_pieceB_joyous_anxious_sad' | song == 'stimuli/11_pieceA_calm_anxious_sad' | song == 'stimuli/12_pieceA_joyous_sad_anxious')
neg_neg_portions <- negative_potential_stims %>%
subset(valence_filt < 0) %>%
subset(arousal_filt < 0)
ggplot(data=neg_neg_portions,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
labs(title = "Negative Valence Negative Arousal Sections of Musical Stimuli", x = "Time", y = "Valence")
View(neg_neg_portions)
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
labs(title = "Negative Valence Positive Arousal Sections of Musical Stimuli", x = "Time", y = "Valence")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
labs(title = "Negative Valence Positive Arousal Sections of Musical Stimuli", x = "Time", y = "Valence")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
#geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
labs(title = "Negative Valence Positive Arousal Sections of Musical Stimuli", x = "Time", y = "Valence")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
#geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
labs(title = "Negative Valence Positive Arousal Sections of Musical Stimuli", x = "Time", y = "Valence")
library(tidyverse)
library(forcats)
install.packages("zoo")
library(zoo)
data <- read.csv("../stimuli/sachs/SourceData_1.csv")
data$song <- gsub("^stimuli/", "", data$song)
# actual time in song is +5 from data
data$second <- data$second + 5
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_point(aes(color = song)) +
#labs(title = "Negative Valence Sections of Musical Stimuli", x = "Time", y = "Valence") +
theme(legend.position = "none") #uncomment this for a clearer timing est
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_hline(xintercept=0,color="red",linetype="dashed")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_hline(xintercept=0,color="red",linetype="dashed")+
geom_point(aes(color = song)) +
#labs(title = "Negative Valence Sections of Musical Stimuli", x = "Time", y = "Valence") +
theme(legend.position = "none")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_point(aes(color = song)) +
#labs(title = "Negative Valence Sections of Musical Stimuli", x = "Time", y = "Valence") +
theme(legend.position = "none")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_point(aes(color = song))
ggplot(data=data,
aes(x = second, y = arousal_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_point(aes(color = song))
View(data)
pos_only <- data %>%
subset(valence_filt>0)
View(pos_only)
unique(pos_only$song)
View(pos_only)
neg_only <- data %>%
subset(valence_filt<0)
unique(neg_only$song)
setdiff(pos_only, neg_only)
setdiff(unique(pos_only$song), unique(neg_only$song))
pos_only <- data %>%
subset(arousal_filt>0)
unique(pos_only$song)
neg_only <- data %>%
subset(arousal_filt<0)
unique(neg_only$song)
setdiff(unique(pos_only$song), unique(neg_only$song))
ggplot(data=data,
aes(x = second, y = arousal_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_smooth()
ggplot(data=data,
aes(x = second, y = arousal_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_smooth(aes(color=stim))
ggplot(data=data,
aes(x = second, y = arousal_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_smooth(aes(color=song))
ggplot(data=data,
aes(x = second, y = arousal_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_smooth(aes(color=song)) +
#labs(title = "Negative Valence Sections of Musical Stimuli", x = "Time", y = "Valence") +
theme(legend.position = "none")
ggplot(data=data,
aes(x = second, y = valence_filt)) +
theme_classic() +
geom_hline(yintercept=0,color="red",linetype="dashed")+
geom_smooth(aes(color=song)) +
#labs(title = "Negative Valence Sections of Musical Stimuli", x = "Time", y = "Valence") +
theme(legend.position = "none")
