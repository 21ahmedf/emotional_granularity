position = position_dodgenudge(width = 0.2, x = 0.3), linewidth = 1,size=1) +
scale_x_discrete(labels = c("Different","Similar")) +
scale_color_manual(values = c(Music = "#D55E00", Images = "#0072B2"),
labels = c("Negative", "Positive")) +
labs(x = NULL, y = "Emotional granularity", color = "Emotion valence") +
theme_classic(base_size = 12) +
facet_wrap(~valence,scales = "free_x") +
xlab("Arousal Level") +
ylab("Average Fisher-Transformed\nCorrelation Among Emotion Ratings")+
theme(
axis.title.x = element_text(family="Arial", size=50),
axis.title.y = element_text(family="Arial",size=50),
axis.text.x = element_text(family="Arial", size=44),
axis.text.y = element_text(family="Arial",size=44),
strip.text = element_text(family="Arial",size=44)) +
theme(legend.position = "none")
ggsave('../figures/arousal_differentiation2.png', arousal_differentiation,dpi=1000, width=14, height=12)
ggsave('../figures/arousal_differentiation2.png', arousal_differentiation,dpi=1000)
ggsave('../figures/arousal_differentiation2.png', arousal_differentiation,dpi=1000, width=14, height=12)
