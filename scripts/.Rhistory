library(lme4)
library(lmerTest)   # Satterthwaite df for the t test in simr
library(simr)
set.seed(08061999)
m3 <- lmer(granularity_music ~ granularity_pic * valence +
endorse_rate_music_c + endorse_rate_pic_c +
mean_int_music_c + mean_int_pic_c +
(1 | Participant.Public.ID), data = gran_wide)
# Set the coefficient to your SMALLEST EFFECT SIZE OF INTEREST (raw units of
# granularity_music per 1-unit change in granularity_pic) -- NOT the observed
# estimate (that would be post-hoc/observed power).
sesoi <- 0.15                                   # <-- justify this value
# Set the coefficient to your SMALLEST EFFECT SIZE OF INTEREST (raw units of
# granularity_music per 1-unit change in granularity_pic) -- NOT the observed
# estimate (that would be post-hoc/observed power).
sesoi <-fixef(m3)["granularity_pic"]
# Power at current sample size
powerSim(m3, test = fixed("granularity_pic", "t"), nsim = 1000)
m3 <- lmer(granularity_music ~ granularity_pic * valence +
endorse_rate_music_c + endorse_rate_pic_c +
mean_int_music_c + mean_int_pic_c +
(1 | Participant.Public.ID), data = gran_wide)
fixed <- fixef(m3)                     # all fixed effects from m3, in the right order
V2  <- VarCorr(m3)[[1]]                # random intercept variance for Participant.Public.ID
res <- sigma(m3)                       # residual SD
m2 <- makeLmer(granularity_music ~ granularity_pic * valence +
endorse_rate_music_c + endorse_rate_pic_c +
mean_int_music_c + mean_int_pic_c +
(1 | Participant.Public.ID),
fixef = fixed, VarCorr = V2, sigma = res, data = gran_wide)
m2_ext <- extend(m2, along = "Participant.Public.ID", n = 300)  # max N to consider
oc2 <- powerCurve(m2_ext, along = "Participant.Public.ID",
test = fixed("granularity_pic", "t"),
breaks = seq(50, 300, 50), nsim = 500, seed = 861999)
plot(oc2)
View(oc2)
oc2[["ps"]][[1]][["pval"]]
print(oc2)            # will likely show 0 successful simulations / all NA
oc2$errors            # or: lastResult()$errors
