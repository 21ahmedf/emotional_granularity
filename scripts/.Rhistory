library(lme4)
library(lmerTest)   # load before building models so the "t" test works
library(simr)
seed <- 861999
# ---- 1. Clean data: keep complete cases on model variables ----
vars <- c("granularity_music", "granularity_pic", "valence",
"endorse_rate_music_c", "endorse_rate_pic_c",
"mean_int_music_c", "mean_int_pic_c", "Participant.Public.ID")
gran_cc <- droplevels(na.omit(as.data.frame(gran_wide[, vars])))
gran_cc$Participant.Public.ID <- factor(gran_cc$Participant.Public.ID)
gran_cc$valence <- factor(gran_cc$valence)
cat("Participants before:", length(unique(gran_wide$Participant.Public.ID)),
" after:", nlevels(gran_cc$Participant.Public.ID), "\n")
# ---- 2. Fit the model on the clean data ----
m3 <- lmer(granularity_music ~ granularity_pic * valence +
endorse_rate_music_c + endorse_rate_pic_c +
mean_int_music_c + mean_int_pic_c +
(1 | Participant.Public.ID), data = gran_cc)
# ---- 3. Set the effect size for granularity_pic ----
# Option 1: raw units
sesoi <- 0.15
# Option 2: define in SD units (uncomment to use; e.g. 0.20 SD per SD)
# sesoi <- 0.20 * sd(gran_cc$granularity_music) / sd(gran_cc$granularity_pic)
fixed <- fixef(m3)
fixed["granularity_pic"] <- sesoi
V2  <- VarCorr(m3)[[1]]   # random intercept variance
res <- sigma(m3)          # residual SD
# ---- 4. Build the simulation model ----
m2 <- makeLmer(formula(m3), fixef = fixed, VarCorr = V2,
sigma = res, data = gran_cc)
# ---- 5. Quick check: should show 0 errors ----
check <- powerSim(m2, test = fixed("granularity_pic", "t"),
nsim = 10, seed = seed)
print(check)
print(check$errors)
# ---- 6. Power at current N ----
sim_gran <- powerSim(m2, test = fixed("granularity_pic", "t"),
nsim = 1000, seed = seed)
print(sim_gran)
# ---- 7. Power curve across sample sizes ----
m2_ext <- extend(m2, along = "Participant.Public.ID", n = 300)
oc2 <- powerCurve(m2_ext, along = "Participant.Public.ID",
test = fixed("granularity_pic", "t"),
breaks = seq(50, 300, by = 25),
nsim = 500, seed = seed)
print(oc2)
plot(oc2)
library(lmerTest)
