gloomy_upset_cor, sad_anxious_cor, sad_upset_cor,
scared_upset_cor, scared_anxious_cor, upset_anxious_cor,
sad_scared_cor)
names(neg_list) <- c("gloomy_sad","gloomy_scared","gloomy_anxious",
"gloomy_upset","sad_anxious","sad_upset",
"scared_upset","scared_anxious","upset_anxious",
"sad_scared")
arousal_lookup <- c(
# Positive
relaxed_excited = "different", relaxed_satisfied = "same",
relaxed_happy   = "different", relaxed_joyful    = "different",
excited_satisfied = "different", excited_happy   = "same",
excited_joyful  = "same",      satisfied_happy   = "different",
satisfied_joyful = "different", joyful_happy     = "same",
# Negative
gloomy_sad     = "same",      gloomy_scared  = "different",
gloomy_anxious = "different", gloomy_upset   = "different",
sad_anxious    = "different", sad_upset      = "different",
scared_upset   = "same",      scared_anxious = "same",
upset_anxious  = "same",      sad_scared     = "different"
)
## creating one df
pos <- dplyr::bind_rows(pos_list, .id = "pair"); pos$valence <- "Positive"
neg <- dplyr::bind_rows(neg_list, .id = "pair"); neg$valence <- "Negative"
master_posneg <- rbind(pos, neg)
master_posneg$arousal_dif <- unname(arousal_lookup[as.character(master_posneg$pair)])
## center factor contrasts
for (v in c("condition", "arousal_dif", "valence")) {
master_posneg[[v]] <- factor(master_posneg[[v]])
contrasts(master_posneg[[v]]) <- c(-0.5, 0.5)
}
master_posneg$pair <- factor(master_posneg$pair)
## get covs, fisher-transform cors, remove outliers
covs_cond <- master_ratingsperemotion %>%
group_by(Participant.Public.ID, condition) %>%
summarise(endorse_rate_cond = mean(endorse, na.rm = TRUE),
mean_int_cond     = mean(value, na.rm = TRUE), .groups = "drop") %>%
group_by(Participant.Public.ID) %>%
mutate(across(c(endorse_rate_cond, mean_int_cond),
~ .x - mean(.x), .names = "{.col}_c")) %>%
ungroup()
master_posneg <- merge(master_posneg, covs_cond)
master_posneg$cor_z <- psych::fisherz(pmin(pmax(master_posneg$cor, -0.999), 0.999)) #helps with replacing infinity
master_posneg <- remove_outliers_iqr(master_posneg, "cor_z")
## model
m5 <- lmer(cor_z ~ condition * arousal_dif * valence +
endorse_rate_cond_c + mean_int_cond_c +
(condition + arousal_dif + valence | Participant.Public.ID) +
(condition | pair),
data = master_posneg)
car::Anova(m5, type = "II")
#breaking down
emm <- emmeans(m5, ~  condition | arousal_dif, lmer.df = "satterthwaite",lmerTest.limit = 5281)
emm
# interaction (two-way)
pairs(emm)
# interaction contrast
contrast(emmeans(m5, ~ arousal_dif * condition, lmer.df = "satterthwaite",lmerTest.limit = 5281),
interaction = "pairwise")
#main effect of endorsement
summary(m5)$coefficients["endorse_rate_cond_c", ]
m5 <- lmer(cor_z ~ condition * arousal_dif * valence +
endorse_rate_cond_c + mean_int_cond_c +
(condition + arousal_dif + valence | Participant.Public.ID) +
(condition | pair),
data = master_posneg)
car::Anova(m5, type = "II")
#breaking down
emm <- emmeans(m5, ~  condition | arousal_dif, lmer.df = "satterthwaite",lmerTest.limit = 7579)
emm
# interaction (two-way)
pairs(emm)
# interaction contrast
contrast(emmeans(m5, ~ arousal_dif * condition, lmer.df = "satterthwaite",lmerTest.limit = 7579),
interaction = "pairwise")
#main effect of endorsement
summary(m5)$coefficients["endorse_rate_cond_c", ]
#main effect of rating magnitude
summary(m5)$coefficients["mean_int_cond_c", ]
predictions = emmeans(m5, ~ condition*arousal_dif*valence, lmer.df = "satterthwaite",lmerTest.limit = 5281) %>%
as.data.frame()
predictions$arousal_dif <- ifelse(predictions$arousal_dif=="different", "Different", "Similar")
predictions$condition <- ifelse(predictions$condition=="music", "Music", "Images")
average_corr <-
master_posneg %>%
group_by(condition, valence, Participant.Public.ID,arousal_dif) %>%
summarise(
`cor` = mean(cor, na.rm = TRUE)
)  %>%
mutate(arousal_dif = recode(arousal_dif, "different" = "Different", "same" = "Similar")) %>%
mutate(condition =  recode(condition, "music" = "Music", "pic" = "Images"))
average_corr$cor_z <- psych::fisherz(pmin(pmax(average_corr$cor, -0.999), 0.999))
average_corr <- remove_outliers_iqr(average_corr, "cor_z")
arousal_differentiation <-
ggplot(predictions, aes(arousal_dif, emmean, color = condition)) +
geom_jitter(data = average_corr, aes(arousal_dif, cor_z, color = condition),
#position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.5),
alpha=0.5, width=0.1,size=2 ) +
geom_pointrange(aes(ymin = lower.CL, ymax = upper.CL),
position = position_dodgenudge(width = 0.2, x = 0.3), linewidth = 1,size=1) +
scale_x_discrete(labels = c("Different","Similar")) +
scale_color_manual(values = c(Music = "#D55E00", Images = "#0072B2"),
labels = c("Negative", "Positive")) +
labs(x = NULL, y = "Emotional granularity", color = "Emotion valence") +
theme_classic(base_size = 12) +
facet_wrap(~valence,scales = "free_x") +
xlab("Arousal Level") +
ylab("Average Fisher-Transformed\nCorrelation Among Emotion Ratings")+
theme(
axis.title.x = element_text(family="Arial", size=50),
axis.title.y = element_text(family="Arial",size=50),
axis.text.x = element_text(family="Arial", size=44),
axis.text.y = element_text(family="Arial",size=44),
strip.text = element_text(family="Arial",size=44)) +
theme(legend.position = "none")
ggsave('../figures/arousal_differentiation2.png', arousal_differentiation,dpi=1000, width=14, height=12)
View(predictions)
