summarise(endorse_rate = mean(endorse, na.rm = TRUE),
mean_int     = mean(value, na.rm = TRUE), .groups = "drop") %>%
group_by(Participant.Public.ID) %>%
mutate(across(c(endorse_rate, mean_int),
~ .x - mean(.x), .names = "{.col}_c")) %>%
ungroup()
gran_dat <- left_join(gran_long, covs,
by = c("Participant.Public.ID", "condition", "valence"))
View(gran_dat)
covs <- master_ratingsperemotion %>%
group_by(Participant.Public.ID, condition, valence = rating_valence) %>%
summarise(endorse_rate = mean(endorse, na.rm = TRUE),
mean_int     = mean(value, na.rm = TRUE), .groups = "drop") %>%
group_by(Participant.Public.ID) %>%
mutate(across(c(endorse_rate, mean_int),
~ .x - mean(.x), .names = "{.col}_c")) %>%
ungroup()
View(final)
gran_long <- final %>%
rename(Participant.Public.ID = ID) %>%
pivot_longer(cols = matches("^(neg|pos)(music|pic)ICC$"),
names_to = c("valence", "condition"),
names_pattern = "^(neg|pos)(music|pic)ICC$",
values_to = "granularity") %>%
mutate(valence     = recode(valence, neg = "negative", pos = "positive"),) %>%
select(Participant.Public.ID,valence:granularity)
covs <- master_ratingsperemotion %>%
group_by(Participant.Public.ID, condition, valence = rating_valence) %>%
summarise(endorse_rate = mean(endorse, na.rm = TRUE),
mean_int     = mean(value, na.rm = TRUE), .groups = "drop") %>%
group_by(Participant.Public.ID) %>%
mutate(across(c(endorse_rate, mean_int),
~ .x - mean(.x), .names = "{.col}_c")) %>%
ungroup()
gran_dat <- left_join(gran_long, covs,
by = c("Participant.Public.ID", "condition", "valence"))
View(gran_dat)
# effects of gran, controlled for endorsement rate + mean response
m3 <- lmer(granularity ~ condition * valence +
endorse_rate_c*condition + mean_int_c*condition +
(1 | Participant.Public.ID), data = gran_dat)
car::Anova(m3, type="II")
emtrends(m3, ~ condition, var = "endorse_rate_c")
emtrends(m3, ~ condition, var = "mean_int_c")
pe <- ggemmeans(m3, terms = c("endorse_rate_c [all]", "condition"))
pm <- ggemmeans(m3, terms = c("mean_int_c [all]", "condition"))
plot_fx <- function(pred, raw_x, xlab) {
ggplot(pred, aes(x, predicted, color = group, fill = group)) +
geom_point(data = gran_dat,
aes(x = .data[[raw_x]], y = granularity, color = condition),
inherit.aes = FALSE, alpha = 0.15, size = 1) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2, color = NA) +
geom_line(linewidth = 1) +
scale_color_manual(values = c(music = "#0072B2", pic = "#D55E00"),
labels = c("Music", "Images"), aesthetics = c("color", "fill")) +
labs(x = xlab, y = "Emotional granularity", color = NULL, fill = NULL) +
theme_classic(base_size = 12)
}
plot_fx(pe, "endorse_rate_c", "Endorsement rate\n(Within-participant mean-centered)") +
plot_fx(pm, "mean_int_c", "Mean rating intensity\n(Within-participant mean-centered)") +
plot_layout(guides = "collect") &
theme(legend.position = "top")
